# ============================================
# CI/CD Environment Variables
# ============================================
# Copy to .env.ci and fill in your values.
# NEVER commit .env.ci to git.
#
# Add these as GitHub Secrets:
#   Settings → Secrets and variables → Actions → New repository secret

# --- GitHub Release ---
GITHUB_OWNER=your-github-username
GITHUB_REPO=claude-code-gui
GITHUB_TOKEN=${{ secrets.GITHUB_TOKEN }}

# --- Windows Code Signing (optional) ---
# Base64-encoded .pfx certificate file
# To encode: base64 -i cert.pfx -o cert.txt
# WIN_CSC_FILE=/path/to/certificate.pfx
# WIN_CSC_PASSWORD=your-cert-password

# --- macOS Notarization (optional) ---
# APPLE_ID=your-apple-id@email.com
# APPLE_TEAM_ID=YOUR_TEAM_ID
# APPLE_APP_SPECIFIC_PASSWORD=xxxx-xxxx-xxxx-xxxx
# APPLE_IDENTITY=Developer ID Application: Your Name (TEAMID)

# --- S3 Distribution (optional) ---
# AWS_ACCESS_KEY_ID=your-aws-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret
# AWS_S3_BUCKET=your-bucket-name
# AWS_REGION=us-east-1

# --- Generic Update Server (optional) ---
# UPDATE_SERVER_URL=https://updates.your-domain.com

# --- Sentry / Crash Reporting (optional) ---
# SENTRY_DSN=https://your-sentry-dsn

# --- App Configuration ---
# Pre-configure the app for enterprise deployment
# VITE_ANTHROPIC_API_KEY=sk-...
# VITE_API_BASE_URL=https://api.openai.com
# VITE_MODEL_NAME=gpt-4o
